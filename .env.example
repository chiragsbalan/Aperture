# Copy to .env and adjust. Never commit real secrets.
# Used by docker compose and local non-Docker runs.
# Backend Settings also reads this repo-root file (and optional backend/.env).

# --- App ---
APP_NAME=Aperture
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Postgres (Compose service: db) ---
# Defaults are for local-only use. Prefer URL-safe characters in user/password
# (avoid @ : / #) — Compose builds the API DSN from these values.
POSTGRES_USER=aperture
POSTGRES_PASSWORD=aperture
POSTGRES_DB=aperture
POSTGRES_PORT=5432

# Host-side API / tests (localhost). Compose overrides DATABASE_URL to use @db.
DATABASE_URL=postgresql+asyncpg://aperture:aperture@localhost:5432/aperture

# --- Cloud Postgres (Supabase Free) — set on Render, not in git ---
# Use the Session pooler URI from Supabase → Connect (port 5432).
# Do NOT use the transaction pooler (port 6543) for Alembic DDL.
# Rewrite the scheme for async SQLAlchemy / asyncpg:
#   postgresql://...  →  postgresql+asyncpg://...
# URL-encode special characters in the password (e.g. @ → %40).
# Example shape (fake credentials):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase requires TLS. The app enables asyncpg SSL automatically for non-local
# hosts (sslmode=require semantics; see app/core/db_ssl.py). Do not rely on
# ?ssl=require with +asyncpg.
# Direct db.<ref>.supabase.co hosts are IPv6-only on free tier — prefer the pooler.
# Render start.sh runs `alembic upgrade head` on every container start (incl. cold wake).

# --- Ports ---
API_PORT=8000
WEB_PORT=3000

# --- Frontend / BFF ---
# Server-only upstream for Next.js `/api/proxy/...` → FastAPI.
# Local Compose sets API_URL=http://api:8000 on the web service.
# Vercel (production/preview): set API_URL to the Render API origin, e.g.
#   API_URL=https://aperture-api-da3c.onrender.com
API_URL=http://localhost:8000
# Optional legacy/public API origin (browser should prefer same-origin BFF).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- API CORS ---
# Comma-separated browser origins allowed to call FastAPI directly.
# Empty (default) = no CORS middleware; use the Next.js BFF instead.
# Must be explicit http(s) origins — wildcards (*) are rejected.
# CORS_ORIGINS=http://localhost:3000

# --- Auth (ADR-0005) ---
# Strong random secret for signing access JWTs. Required.
# Local/dev placeholder only — set a unique value on Render for production.
JWT_SECRET=local-dev-only-change-me-before-any-real-use
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# Parallel-tab refresh reuse window (seconds). Outside → revoke refresh family.
# REFRESH_REUSE_GRACE_SECONDS=10
# DB-backed auth rate limits (Postgres through P10; Redis shared counters in P11).
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_LOGIN_MAX_FAILURES=10
# AUTH_REGISTER_MAX_FAILURES=5
# Failure-only refresh cap per IP (invalid / outside-grace), not every call.
# AUTH_REFRESH_MAX_PER_IP=30
# Shared secret so the BFF can pass the browser IP for rate limits.
# Required in production for correct IP-based limits (set the same value on
# Vercel web and Render API). Local: use the same value for FE + BE.
# AUTH_BFF_SHARED_SECRET=local-dev-bff-shared-secret-change-me
AUTH_BFF_SHARED_SECRET=local-dev-bff-shared-secret-change-me
# Google OAuth (P1.3). BFF exchanges the code; API never sees the client secret.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Local/CI mock: skip real Google; /api/auth/google/start → mock callback.
AUTH_GOOGLE_MOCK=true
# Optional API rate-limit knob for POST /api/v1/auth/google (default 20 / 15m).
# AUTH_GOOGLE_OAUTH_MAX_PER_IP=20

# --- Metadata / TMDb (P2) ---
# Server-only. Never put this in NEXT_PUBLIC_* or the browser bundle.
# Offline catalog seed needs no key:
#   make migrate && make seed-metadata
# Production ship step (option A): run the same fixture seed against the prod
# DATABASE_URL after migrate. Live TMDb ingest (``--source tmdb``) requires a key
# and is not required for the initial catalog pages.
# TMDB_API_KEY=

# --- Search (P2.3) ---
# Optional overrides; defaults are fine for local/seed scale.
# SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
# SEARCH_RATE_LIMIT_MAX_PER_IP=60

# --- Home rails (catalog top-movies / top-tv / now-in-theatres) ---
# Shared per-IP bucket across all three endpoints (each home load charges 3).
# Default 30 / 60s — headroom for refresh, not scrapers.
# TOP_MOVIES_RATE_LIMIT_MAX_PER_IP=30
# TOP_MOVIES_RATE_LIMIT_WINDOW_SECONDS=60
# Public display cap (Query limit + default clamped to this).
# TOP_MOVIES_MAX_PUBLIC_LIMIT=24
# TOP_MOVIES_DEFAULT_LIMIT=12

# --- Redis (P2.4) ---
# Compose sets REDIS_URL=redis://redis:6379/0 for the api service.
# Host runs / production: Upstash TCP URL (rediss://...). Empty = in-memory cache.
# REDIS_URL=
# METADATA_CACHE_TTL_SECONDS=600

# --- Cloudflare R2 avatars (ADR-0014) ---
# Leave empty locally until you create a Cloudflare account + bucket.
# Setup guide: docs/ops/cloudflare-r2-avatars.md
# Upload endpoints return 503 when these are unset.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=aperture-avatars
# Public CDN base (custom domain or r2.dev), no trailing slash required:
# R2_PUBLIC_BASE_URL=https://media.example.com
# R2_UPLOAD_URL_TTL_SECONDS=120
# AVATAR_MAX_BYTES=2097152
# Frontend CSP / next/image host (hostname only — rebuild FE after change):
# NEXT_PUBLIC_MEDIA_HOST=media.example.com
