# Copy to .env and adjust. Never commit real secrets.
# Used by docker compose and local non-Docker runs.
# Backend Settings also reads this repo-root file (and optional backend/.env).

# --- App ---
APP_NAME=Aperture
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Postgres (Compose service: db) ---
# Defaults are for local-only use. Prefer URL-safe characters in user/password
# (avoid @ : / #) — Compose builds the API DSN from these values.
POSTGRES_USER=aperture
POSTGRES_PASSWORD=aperture
POSTGRES_DB=aperture
POSTGRES_PORT=5432

# Host-side API / tests (localhost). Compose overrides DATABASE_URL to use @db.
DATABASE_URL=postgresql+asyncpg://aperture:aperture@localhost:5432/aperture

# --- Cloud Postgres (Supabase Free) — set on Render, not in git ---
# Use the Session pooler URI from Supabase → Connect (port 5432).
# Do NOT use the transaction pooler (port 6543) for Alembic DDL.
# Rewrite the scheme for async SQLAlchemy / asyncpg:
#   postgresql://...  →  postgresql+asyncpg://...
# URL-encode special characters in the password (e.g. @ → %40).
# Example shape (fake credentials):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase requires TLS. The app enables asyncpg SSL automatically for non-local
# hosts (see app/core/db_ssl.py). Do not rely on ?ssl=require with +asyncpg.
# Direct db.<ref>.supabase.co hosts are IPv6-only on free tier — prefer the pooler.
# Render start.sh runs `alembic upgrade head` on every container start (incl. cold wake).

# --- Ports ---
API_PORT=8000
WEB_PORT=3000

# --- Frontend / BFF ---
# Server-only upstream for Next.js `/api/proxy/...` → FastAPI.
# Local Compose sets API_URL=http://api:8000 on the web service.
# Vercel (production/preview): set API_URL to the Render API origin, e.g.
#   API_URL=https://aperture-api-da3c.onrender.com
API_URL=http://localhost:8000
# Optional legacy/public API origin (browser should prefer same-origin BFF).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- API CORS ---
# Comma-separated browser origins allowed to call FastAPI directly.
# Empty (default) = no CORS middleware; use the Next.js BFF instead.
# Must be explicit http(s) origins — wildcards (*) are rejected.
# CORS_ORIGINS=http://localhost:3000

# --- Auth (ADR-0005) ---
# Strong random secret for signing access JWTs. Required.
# Local/dev placeholder only — set a unique value on Render for production.
JWT_SECRET=local-dev-only-change-me-before-any-real-use
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
